{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "ignaciosanchez.vercel.app" }],
      "destination": "https://www.sanchezign.dev/:path",
      "permanent": true
    },
    {
      "source": "/cv/ignacio-sanchez-cv-es.pdf",
      "destination": "/cv/CV_Ignacio_Sanchez_ES.pdf",
      "permanent": true
    },
    {
      "source": "/cv/ignacio-sanchez-cv-en.pdf",
      "destination": "/cv/CV_Ignacio_Sanchez_EN.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
